/*
 * 6 键宏键盘 keymap
 *
 * 6 个按键 = 功能按钮（一按即触发动作，不用来打字）
 *   上排: 播放/暂停 | 上一曲 | 下一曲
 *   下排: 静音     | 截图   | 锁屏
 *
 * 旋钮 1: 音量加 / 音量减
 * 旋钮 2: 向下翻页 / 向上翻页
 *
 * 改键有两种方式：
 *   1. 网页实时改（推荐）：USB 连 Mac → Chrome 打开 https://zmk.studio
 *      → 先按住 键1 + 键3 解锁 → 拖拽改键，即时生效、不用重新编译。
 *   2. 改这个文件后重新编译刷入。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_PLAY_PAUSE   &kp C_PREV               &kp C_NEXT
                &kp C_MUTE         &kp LG(LS(NUMBER_4))     &kp LG(LC(Q))
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>
                              <&inc_dec_kp PG_DN PG_UP>;
        };
    };

    /* 按住 键1 + 键3 同时按一下，解除 ZMK Studio 的写入锁 */
    combos {
        compatible = "zmk,combos";

        studio_unlock_combo {
            timeout-ms = <70>;
            key-positions = <0 2>;
            bindings = <&studio_unlock>;
        };
    };
};
